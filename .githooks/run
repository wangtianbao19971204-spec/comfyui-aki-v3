#!/bin/sh
set -eu
cd "$(git rev-parse --show-toplevel)"
if [ -n "${COMFYUI_MAINTENANCE_PYTHON:-}" ]; then
    interpreter="$COMFYUI_MAINTENANCE_PYTHON"
elif [ -x ../../python/python.exe ]; then
    interpreter=../../python/python.exe
elif command -v python3 >/dev/null 2>&1; then
    interpreter=python3
else
    interpreter=python
fi
if [ "${1:-}" = "--staged" ]; then
    "$interpreter" -X utf8 -B scripts/technical_catalog.py check --staged --enforce-changes
    exec "$interpreter" -X utf8 -B scripts/security_guard.py "$@" --cache-staged
else
    "$interpreter" -X utf8 -B scripts/technical_catalog.py check --require-tracked
fi
exec "$interpreter" -X utf8 -B scripts/security_guard.py "$@"
