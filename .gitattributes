# Preserve captured bytes; hashes must survive a Windows clone.
* -text -filter -ident -working-tree-encoding
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.gz binary
# Schema baselines retain SQLite's original trigger whitespace for fingerprints.
database/schema/v1/*.sql whitespace=-blank-at-eol
