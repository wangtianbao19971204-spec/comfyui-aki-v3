                  "rawTag": "0.2::misaka 12003-gou ::, 0.3::toma ::, 0.15::takahashi (k2ta7) ::, 0.3::mignon ::, 0.3::ebora ::, 0.4::himemura saki ::, typehatena, 0.9::wagashi (dagashiya) ::, 0.8::utsusumi kio ::, 0.6::modare ::, 1::mameojitan, 1.1::artist:shinjiro ::, artist:imamura ryou, 1.::artist:lunch (shin new) ::, 0.8::healthyman ::, 0.3::nyantcha ::, 0.4:: ie (raarami), 0.4::artist:hiro (dismaless) ::, 0.7::pumpkinspicelatte, 0.4::nonco ::, 0.45::freng ::, 0.4::ohisashiburi ::, 0.4::ixy ::, 0.4::happoubi jin::, 0.4::raita::, year 2025, year 2026, very aesthetic, am           azing quality, 0.7::thick lineart ::, -3::monochrome, greyscale::, 1.2::high complexity::, \n -3::censored::, -3::official art, official style::,",
                  "characterPrompts": [
                    {
                      "label": "char1",
                      "prompt": "nsfw, girl, solo, itokonoue kaoru, project kv\n薄いベージュのニットと短いデニムスカート、足元は白いスニーカー。公園のベンチに座っている。\n脚を組み、上体を前に倒して顎を手の甲に乗せ、膝の隙間から下着がチラ見えする角度。風でニットが体に張り付く。\nローアングル気味の全身、ベンチと脚線を強調。\n木漏れ日の自然光、まだらな明るい斑点。",
                      "negative": "3::choker::,"
                    }
                  ]
                },
                {
                  "path": "nai5_community_pack_suozhang_set_0130-03.jpg",
                  "original": "nai5_community_pack_suozhang_set_0130-03.webp",
                  "rawTag": "0.2::misaka 12003-gou ::, 0.3::toma ::, 0.15::takahashi (k2ta7) ::, 0.3::mignon ::, 0.3::ebora ::, 0.4::himemura saki ::, typehatena, 0.9::wagashi (dagashiya) ::, 0.8::utsusumi kio ::, 0.6::modare ::, 1::mameojitan, 1.1::artist:shinjiro ::, artist:imamura ryou, 1.::artist:lunch (shin new) ::, 0.8::healthyman ::, 0.3::nyantcha ::, 0.4:: ie (raarami), 0.4::artist:hiro (dismaless) ::, 0.7::pumpkinspicelatte, 0.4::nonco ::, 0.45::freng ::, 0.4::ohisashiburi ::, 0.4::ixy ::, 0.4::happoubi jin::, 0.4::raita::, year 2025, year 2026, very aesthetic, am           azing quality, 0.7::thick lineart ::, -3::monochrome, greyscale::, 1.2::high complexity::, \n -3::censored::, -3::official art, official style::,",
                  "characterPrompts": [
                    {
                      "label": "char1",
                      "prompt": "nsfw, girl, solo, itokonoue kaoru, project kv\n白い競泳水着、濡れて生地が肌に張り付いている。プールサイドに座っている。\n両腕を後ろに突いて上体を反らし、濡れた太ももを揃えて伸ばす。水滴が鎖骨を伝う。少し息が上がった顔。\nローアングル、脚から顔まで通した全身。水面の反射が入る。\n真夏の強い直射日光と水面のキラキラした反射光。",
                      "negative": "3::choker::,"
                    }
                  ]
                },
                {
                  "path": "nai5_community_pack_suozhang_set_0130-04.jpg",
                  "original": "nai5_community_pack_suozhang_set_0130-04.webp",
                  "rawTag": "0.2::misaka 12003-gou ::, 0.3::toma ::, 0.15::takahashi (k2ta7) ::, 0.3::mignon ::, 0.3::ebora ::, 0.4::himemura saki ::, typehatena, 0.9::wagashi (dagashiya) ::, 0.8::utsusumi kio ::, 0.6::modare ::, 1::mameojitan, 1.1::artist:shinjiro ::, artist:imamura ryou, 1.::artist:lunch (shin new) ::, 0.8::healthyman ::, 0.3::nyantcha ::, 0.4:: ie (raarami), 0.4::artist:hiro (dismaless) ::, 0.7::pumpkinspicelatte, 0.4::nonco ::, 0.45::freng ::, 0.4::ohisashiburi ::, 0.4::ixy ::, 0.4::happoubi jin::, 0.4::raita::, year 2025, year 2026, very aesthetic, am           azing quality, 0.7::thick lineart ::, -3::monochrome, greyscale::, 1.2::high complexity::, \n -3::censored::, -3::official art, official style::,",
                  "characterPrompts": [
                    {
                      "label": "char1",
                      "prompt": "nsfw, girl, solo, itokonoue kaoru, project kv\n黒いレースのテディにガーターベルト、ストッキング、高いヒール。白いシームレス背景のスタジオ。\n四つん這いに近い前傾ポーズで腰を落とし、肩越しに振り返って舌先を見せる。胸が重力で前に落ちる角度。\n斜め後ろからのヒップフォーカス、顔は振り返りで見せるダイナミックアングル。\n強いソフトボックスの直接光、影をくっきり落とすファッション撮影照明。",
                      "negative": "3::choker::,"
                    }
                  ]
                },
                {
                  "path": "nai5_community_pack_suozhang_set_0130-05.jpg",
                  "original": "nai5_community_pack_suozhang_set_0130-05.webp",
                  "rawTag": "0.2::misaka 12003-gou ::, 0.3::toma ::, 0.15::takahashi (k2ta7) ::, 0.3::mignon ::, 0.3::ebora ::, 0.4::himemura saki ::, typehatena, 0.9::wagashi (dagashiya) ::, 0.8::utsusumi kio ::, 0.6::modare ::, 1::mameojitan, 1.1::artist:shinjiro ::, artist:imamura ryou, 1.::artist:lunch (shin new) ::, 0.8::healthyman ::, 0.3::nyantcha ::, 0.4:: ie (raarami), 0.4::artist:hiro (dismaless) ::, 0.7::pumpkinspicelatte, 0.4::nonco ::, 0.45::freng ::, 0.4::ohisashiburi ::, 0.4::ixy ::, 0.4::happoubi jin::, 0.4::raita::, year 2025, year 2026, very aesthetic, am           azing quality, 0.7::thick lineart ::, -3::monochrome, greyscale::, 1.2::high complexity::, \n -3::censored::, -3::official art, official style::,",
                  "characterPrompts": [
                    {
                      "label": "char1",
                      "prompt": "nsfw, girl, solo, itokonoue kaoru, project kv\n夜のベランダ。彼女は深いスリットの黒いドレスを腿までたくし上げ、下着は履いていない。耳元の長いピアス、片手にワイングラス。\n欄干に腰を預け、片脚を軽く上げてドレスのスリットを自ら開いて見せる。顎を引き、カメラを下から見る表紙の目線。\nローアングルのバストアップ、開いたスリットと胸元、顔が中央。\n室内から漏れる暖かい光と、遠景の街のボケ。ガラスの映り込みは描かない。",
                      "negative": "3::choker::,"
                    }
                  ]
                },
                {
                  "path": "nai5_community_pack_suozhang_set_0130-06.jpg",
                  "original": "nai5_community_pack_suozhang_set_0130-06.webp",
                  "rawTag": "0.2::misaka 12003-gou ::, 0.3::toma ::, 0.15::takahashi (k2ta7) ::, 0.3::mignon ::, 0.3::ebora ::, 0.4::himemura saki ::, typehatena, 0.9::wagashi (dagashiya) ::, 0.8::utsusumi kio ::, 0.6::modare ::, 1::mameojitan, 1.1::artist:shinjiro ::, artist:imamura ryou, 1.::artist:lunch (shin new) ::, 0.8::healthyman ::, 0.3::nyantcha ::, 0.4:: ie (raarami), 0.4::artist:hiro (dismaless) ::, 0.7::pumpkinspicelatte, 0.4::nonco ::, 0.45::freng ::, 0.4::ohisashiburi ::, 0.4::ixy ::, 0.4::happoubi jin::, 0.4::raita::, year 2025, year 2026, very aesthetic, am           azing quality, 0.7::thick lineart ::, -3::monochrome, greyscale::, 1.2::high complexity::, \n -3::censored::, -3::official art, official style::,",
                  "characterPrompts": [
                    {
                      "label": "char1",
                      "prompt": "nsfw, girl, solo, itokonoue kaoru, project kv\n薄暗い室内スタジオ。彼女は黒いレースのカップレスボディスーツ、胸は完全に露出し、腹から腰にかけて細いストラップが斜めに走り、股はレースで覆われている。下着の重ね履きはなし。\n体を少しひねって立ち、片手を後頭部に上げて髪を梳く仕草。カメラを真っ直ぐ見て、唇は半開き。\nアイレベルのカウボーイショット、顔と露出した胸、ストラップのラインが画面の中心。\n横からの硬いキーライト、反対側のコンクリート壁は落ちる影。ガラスの映り込みは描かない。",
                      "negative": "3::choker::, 3::katana, weapon::,"
                    }
                  ]
                },
                {
                  "path": "nai5_community_pack_suozhang_set_0130-07.jpg",
                  "original": "nai5_community_pack_suozhang_set_0130-07.webp",
                  "rawTag": "0.2::misaka 12003-gou ::, 0.3::toma ::, 0.15::takahashi (k2ta7) ::, 0.3::mignon ::, 0.3::ebora ::, 0.4::himemura saki ::, typehatena, 0.9::wagashi (dagashiya) ::, 0.8::utsusumi kio ::, 0.6::modare ::, 1::mameojitan, 1.1::artist:shinjiro ::, artist:imamura ryou, 1.::artist:lunch (shin new) ::, 0.8::healthyman ::, 0.3::nyantcha ::, 0.4:: ie (raarami), 0.4::artist:hiro (dismaless) ::, 0.7::pumpkinspicelatte, 0.4::nonco ::, 0.45::freng ::, 0.4::ohisashiburi ::, 0.4::ixy ::, 0.4::happoubi jin::, 0.4::raita::, year 2025, year 2026, very aesthetic, am           azing quality, 0.7::thick lineart ::, -3::monochrome, greyscale::, 1.2::high complexity::, \n -3::censored::, -3::official art, official style::,",
                  "characterPrompts": [
                    {
                      "label": "char1",
                      "prompt": "nsfw, girl, solo, itokonoue kaoru, project kv\n薄いカーテンの内側、室内。彼女は黒いチューブトップを胸の下までずらし、ピンク文字で DADDY と書かれている。黒いショーツの股付近には小さなピンク文字で Please。首元はピンクのリボンチョーカーにストーン、両手首にキラキラしたピンクのブレスレット。\n壁に背を預け、両手でずれたトップの端を押さえて胸の下を見せる。顔は少し傾け、カメラを見つめたまま唇を緩める。\nやや俯瞰の全身に近いカウボーイショット、文字の入った服とチョーカー、押さえられた胸。\nカーテン越しの暖かい室内光、影は柔らかい。ガラスの映り込みは描かない。",
                      "negative": "3::choker::, 3::katana, weapon::,"
                    }
                  ]
