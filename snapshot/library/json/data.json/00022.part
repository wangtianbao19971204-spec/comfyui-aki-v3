      "prompts": [
        {
          "id": "docx-n5-60e5bfbbbc2c38949d2aa9fe",
          "alias": "手可摘月亮",
          "prompt": "2::chibi,chibi only::,2::no pupils::,5::upper body::,5::4格漫画::,a four-panel manga-style scene set in a magical,starry night.in the top-left panel,a wide view of a deep blue night sky filled with twinkling stars and a large,luminous full moon,glowing softly above a quiet meadow.in the top-right panel,a girl stands beneath the moon,raising both hands toward it,using her fingers to measure or frame its size — as if comparing its width to her outstretched hands,a playful,curious expression on her face.in the bottom-left panel,she reaches up with both hands and actually grabs the moon,which has become a solid,glowing sphere,holding it firmly in her palms,her eyes wide with surprise and delight.in the bottom-right panel,she runs away,holding the glowing moon above her head like a giant snowball,her arms stretched high,legs dashing forward,the moon trailing a soft wake of stardust and silver sparkles. her expression is a mix of mischief,excitement,and slight panic,as if she’s making a joyful escape.the overall mood is whimsical,adventurous,and filled with childlike wonder.",
          "description": "",
          "image": "lib_lib2_41380_手可摘月亮.jpg",
          "tags": [],
          "favorite": false,
          "template": false,
