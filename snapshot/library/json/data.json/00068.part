    {
      "id": "codex-a91033942dce",
      "name": "Krea2 情绪版 / 397风格 · 3D渲染",
      "created_at": "2026-09-19T15:17:53.514114",
      "updated_at": "2026-09-19T15:17:53.514154",
      "prompts": [
        {
          "id": "krea2mood397-8e859392fb0a41",
          "alias": "3D Render",
          "prompt": "Style: A dimensionally precise digital-illustration style built on smooth, volumetric modeling that reads as fully three-dimensional through simulated geometry and light rather than drawn line, meticulously calculated illumination with soft ambient occlusion settling naturally into every contour, polished specular response giving forms convincing physical depth and weight, confident sculptural construction replacing traditional linework entirely, and a technically precise, computer-generated intensity built on simulated physical light behavior. Influenced by: real-time 3D-rendering technique, CGI modeling practice, physically based rendering (PBR) method, contemporary animated-render pipeline.. Subject:{prompt}",
          "description": "397 styles｜krea2_397styles-3d_render_3D渲染",
          "image": "ray_style_397_0001.jpg",
          "tags": [
            "Krea2 情绪版",
            "397风格",
            "krea2_397styles-3d_render_3D渲染"
          ],
          "favorite": false,
