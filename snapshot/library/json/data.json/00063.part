        {
          "id": "krea2-1836c5a95abc8a26857d4092",
          "alias": "城市（3）",
          "prompt": "This is a work captured casually with everyday equipment yet imbued with artistic tension. It does not deliberately pursue perfect composition or commercial embellishment, but presents the beauty of life in a genuine and natural manner. The characters' expressions, movements, costume details, and environmental elements all blend together to tell a story about youth, freedom, and the poetic charm of urban corners, allowing viewers to feel a moment of tranquility and beauty amid the bustling city.",
          "description": "",
          "image": "",
          "tags": [],
          "favorite": false,
          "template": false,
          "is_user_plan": false,
          "created_at": "2026-09-17T13:54:20.693554",
