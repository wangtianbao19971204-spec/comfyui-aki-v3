INSERT INTO "sqlite_sequence"("_rowid_","name","seq") VALUES(1,'tag_translation_imports',11);
INSERT INTO "sqlite_sequence"("_rowid_","name","seq") VALUES(2,'tag_translation_history',522);
INSERT INTO "sqlite_sequence"("_rowid_","name","seq") VALUES(3,'tag_alias_imports',1);
CREATE VIRTUAL TABLE hot_tags_fts USING fts5(
    tag, translation_cn, content='hot_tags', content_rowid='rowid',
    tokenize='unicode61'
);
INSERT INTO hot_tags_fts(hot_tags_fts) VALUES('rebuild');
CREATE INDEX idx_category
            ON hot_tags(category)
        ;
CREATE INDEX idx_post_count
            ON hot_tags(post_count DESC)
        ;
CREATE INDEX idx_tag_aliases_canonical
            ON tag_aliases(canonical_tag COLLATE NOCASE)
        ;
CREATE INDEX idx_tag_aliases_source_revision
            ON tag_aliases(source_name, source_revision)
        ;
CREATE INDEX idx_tag_translation_history_run
        ON tag_translation_history(run_id)
        ;
CREATE INDEX idx_tag_translation_history_tag
        ON tag_translation_history(tag)
        ;
CREATE INDEX idx_translation
            ON hot_tags(translation_cn)
        ;
CREATE TRIGGER hot_tags_ad
            AFTER DELETE ON hot_tags BEGIN
                DELETE FROM hot_tags_fts WHERE rowid = OLD.rowid;
            END;
CREATE TRIGGER hot_tags_ai
            AFTER INSERT ON hot_tags BEGIN
                INSERT INTO hot_tags_fts(rowid, tag, translation_cn)
                VALUES (NEW.rowid, NEW.tag, NEW.translation_cn);
            END;
CREATE TRIGGER hot_tags_au
            AFTER UPDATE ON hot_tags BEGIN
                UPDATE hot_tags_fts
                SET tag = NEW.tag, translation_cn = NEW.translation_cn
                WHERE rowid = NEW.rowid;
            END;
COMMIT;
