INSERT INTO "tag_tags" VALUES(334292,935,'一条蜿蜒的土路穿过柔和阳光下生机勃勃的绿色田野和金色稻田。远处连绵起伏的山脉与点缀着蓬松白云的湛蓝天空融为一体。路边的木制电线杆在晒干的土地和散落的砾石上投下纤细的阴影。温暖的金色阳光洒满大地，在翠绿色的植被和琥珀色的农作物之间形成鲜明的对比。','翻译：__023__dup002','',1789512226527,'539fcd18-a7aa-40ab-9303-6c7c4c415faf','ca3bbeff-b409-450e-8896-ad79e3140266');
INSERT INTO "tag_tags" VALUES(334293,935,'小狗眼、下垂眼、桃苏打鸢尾花（外层粉橘、内层水晶蓝）、双月牙和小星星高光、内眼角泪滴状闪粉、三层睫毛（上层黑色、下层白色）、花瓣状下睫毛、延伸至鼻梁的心形腮红、碰触腮红变表情、橙色果冻唇、天鹅颈、蕾丝颈链、高光锁骨、绝对领地（21mm）、绣花猫爪及膝袜、微滑袜露出0.5mm肌肤、乳白色水手裙、led领结（随心情变色）、分层蛋糕袖、小铃铛、云朵形口袋长丝带、从口袋里偷看的ai仓鼠、反重力裙、草莓印花安全短裤，','翻译：__033__dup002','',1789512226527,'1965a367-5e95-4cf6-a558-948adf08003f','ca3bbeff-b409-450e-8896-ad79e3140266');
