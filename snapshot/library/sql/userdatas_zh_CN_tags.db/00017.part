INSERT INTO "tag_tags" VALUES(285887,864,'翻译：这是一幅中国水墨画风格的杰作，一个女孩优雅地站在蜿蜒的山涧旁，身着飘逸的汉服，上面绣着精致的丝绸，周围是云雾缭绕的山峰和松林，传统的亭子在飘浮的云朵中隐约可见，柔和的水墨渐变增强了诗意的氛围，传统的山水构图具有分层的透视，微妙的金色光线透过竹林透进来，精致的樱花花瓣漂浮在水面上，空灵的雾气效果与书法笔触融为一体，宁静的风景体现了人与自然的和谐，色调以柔和的青瓷和墨黑色为主，偶尔点缀着朱红色，超精细的 8k 分辨率，古典中国艺术美学与现代数字渲染技术。','自然语言','rgba(255, 123, 2, .4)',1789470947,'6c8bc849-7463-4b7e-9f07-afc35454cfab','67a73ca2-1094-486f-9ad8-25f9b4bcfaa7');
INSERT INTO "tag_tags" VALUES(285888,864,'a glamorous blonde woman with curly hair wearing a green sequined bikini,riding a sparkling pink dolphin that is jumping out of the water,in a whimsical ocean setting under a starry sky. style: retro illustration,pin-up art lighting: bright sunlight,glittering reflections composition: mid-shot,rule of thirds details: sparkling water droplets,joyful expression,large star in the sky,vintage filter effect quality: high detail,vibrant colors,dreamy,playful a glamorous woman with blonde hair,wearing a sparkly teal bikini,riding on the back of a large,pink,glittery dolphin,both leaping out of the water against a blue sky with a stylized star and small white dots,in the ocean with splashing water. vintage pin-up art,pop art bright sunlight medium shot,dynamic angle sparkling,retro,whimsical,playful','自然语言','rgba(255, 123, 2, .4)',1789470947,'8f331805-7fa8-4774-a441-902024a97876','67a73ca2-1094-486f-9ad8-25f9b4bcfaa7');
