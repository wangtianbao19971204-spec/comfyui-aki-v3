INSERT INTO "tag_tags" VALUES(285950,864,'standing,outdoors,sky,cloud,blue sky,day,cloudscape,mountains,hiking,mount everesta painting of a person standing on a rocky mountain peak,overlooking a majestic mountain range with snow-capped peaks and a glacier in the foreground. the person is silhouetted against the bright blue sky,which is filled with fluffy white clouds. the mountain range is dominated by a snow-covered peak in the middle of the image,and the glacier is visible in the background,creating a stunning contrast between the pristine white snow and the deep blue hues of the surrounding mountains. the overall mood of the painting is awe-inspiring,with the person standing alone in awe of the beauty of the landscape. masterwork,masterpiece,best quality,detailed,depth of field,high detail,best quality,very aesthetic,8k,dynamic pose,depth of field,dynamic angle,adult,aged up','自然语言','rgba(255, 123, 2, .4)',1789470947,'068a2dcc-e579-47a3-90af-aba95f2fd031','67a73ca2-1094-486f-9ad8-25f9b4bcfaa7');
INSERT INTO "tag_tags" VALUES(285951,864,'翻译：站立、户外、天空、云朵、蓝天、白天、云景、山脉、徒步旅行、珠穆朗玛峰。画中，一个人站在岩石山峰上，俯瞰雄伟的山脉，前景是白雪皑皑的山峰和冰川。这个人的轮廓映衬着明亮的蓝天，天空中飘浮着蓬松的白云。画面中央一座白雪皑皑的山峰占据了山脉的主导地位，背景中可见冰川，在洁白的雪山和周围群山的深蓝色之间形成了鲜明的对比。这幅画的整体氛围令人惊叹，画中人独自站立，惊叹于风景之美。杰作、杰作、最佳品质、细节丰富、景深、高细节、最佳品质、非常美观、8k、动态姿势、景深、动态角度、成人、年龄较大','自然语言','rgba(255, 123, 2, .4)',1789470947,'2d5ed560-92eb-41d8-ae1b-90310799cc0e','67a73ca2-1094-486f-9ad8-25f9b4bcfaa7');
