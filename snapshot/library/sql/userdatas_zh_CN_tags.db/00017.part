INSERT INTO "tag_tags" VALUES(286011,864,'they have {{{{sharp,delicate,heart-shaped faces (心形脸)}}}},with high cheekbones. their {{{eyes are almond-shaped phoenix eyes (丹凤眼)}}},sharp and intelligent,with a cool,competitive glint. their expressions are matched with a {{{subtle,confident smirk}}}.','自然语言','rgba(255, 123, 2, .4)',1789470947,'8eb40273-96b6-42bf-90df-88f9eeaf8680','67a73ca2-1094-486f-9ad8-25f9b4bcfaa7');
