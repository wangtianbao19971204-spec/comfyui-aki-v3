INSERT INTO "tag_tags" VALUES(334283,935,'前景中布满了一大片白色的野花，周围散布着绿叶树木，围绕着一根细长的树干。柔和的侧光在模糊的背景中透过浓密的深色树木创造出朦胧的金色光线。精致的花瓣在散射的阳光下闪闪发光，而阴影中的树干与地面上明亮的花卉图案形成鲜明对比。','翻译：__022__dup002','',1789512226527,'17a71f9e-cd49-46bf-b9a0-f333c4af6599','ca3bbeff-b409-450e-8896-ad79e3140266');
