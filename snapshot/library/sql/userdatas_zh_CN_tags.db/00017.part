INSERT INTO "tag_tags" VALUES(285918,864,'this is a highly expressionistic digital painting,filled with chaotic and violent energy,focusing on a monstrous female figure. her form emerges from the darkness in coarse,powerful brushstrokes and splattered colors,blurring the boundary between her body and the background. beneath her signature white hair and glasses,a massive mouth full of sharp teeth is torn open amidst wild textures,appearing as an incarnation of pure rage and appetite. in this black-and-white chaos,two points of fiery red light in her eyes become the only color,glowing like burning embers and filled with irrepressible malice and madness.','自然语言','rgba(255, 123, 2, .4)',1789470947,'f2c51671-011e-4295-913a-de777054de9e','67a73ca2-1094-486f-9ad8-25f9b4bcfaa7');
INSERT INTO "tag_tags" VALUES(285919,864,'tiger,sitting animal,anthropomorphic context,cute expression,pancakes,stack of pancakes,sour cream,cup of sour cream,food on table,table setting,breakfast food,kitchen,indoor scene,wooden table,wooden chair,dining area,sitting on chair,a tiger sits on a wooden chair at a kitchen table,gazing at a stack of pancakes and a cup of sour cream with a curious expression,as if about to enjoy breakfast like a person.','自然语言','rgba(255, 123, 2, .4)',1789470947,'e7e0ddc5-38e8-40af-aea4-e7b58658434e','67a73ca2-1094-486f-9ad8-25f9b4bcfaa7');
INSERT INTO "tag_tags" VALUES(285920,864,'{{{magazine cover,cover,cover page,magazine cover,backlighting,foreshortening}}},a graceful woman in intricate black lace lingerie reclines on a velvet chaise lounge,surrounded by falling rose petals like silent whispers,sheer stockings layered with delicate garters,soft candlelight casting flickering highlights across her skin,deep crimson and shadowed gold color palette,classic oil painting-inspired lighting with chiaroscuro effects,subtle mist rising from a nearby bath,distant vintage mirror reflecting her silhouette in blur,fine embroidery glinting along silk edges,a sensual yet introspective atmosphere,warm twilight tones wrapping the room in softness,asymmetrical composition with layered foreground textiles,subtle canvas-like texture reminiscent of baroque portraiture,soft focus on background drapery and antique furniture,romantic aesthetics blending intimacy and mystery,dreamlike ambiance with lingering shadows and glow,minimalistic setting enhanced by rich textures and elegant contours,cultural symbolism of vulnerability,allure,and feminine power.','自然语言','rgba(255, 123, 2, .4)',1789470947,'a18b98af-b35e-4a47-a077-682fa6cb7e33','67a73ca2-1094-486f-9ad8-25f9b4bcfaa7');
