INSERT INTO "tag_tags" VALUES(286040,864,'from a dramatic low-angle,full-body perspective,a girl stands motionless at the center of an apocalyptic scene. devastation surrounds her,with houses collapsed into rubble and others engulfed in roaring flames. her clothes are tattered and torn,and she is completely drenched in blood. her face is an emotionless mask,staring coldly and directly at the viewer. her eyes pierce the darkness with a menacing,scarlet glow. above the fiery chaos,a colossal blood-red moon dominates the night sky,casting an eerie,crimson light that mixes with the flickering orange glow from the burning buildings,creating deep,dramatic shadows and highlighting the sheer terror of the moment.','自然语言','rgba(255, 123, 2, .4)',1789470947,'06a5333e-bbf5-4118-9438-bf5173ed0a18','67a73ca2-1094-486f-9ad8-25f9b4bcfaa7');
