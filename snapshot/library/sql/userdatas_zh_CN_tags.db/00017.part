INSERT INTO "tag_tags" VALUES(343179,864,'原Tag：a narrow cobblestone path winding forward. stone buildings stand closely on either side of this alley. lanterns hang from the walls and cast a warm glowing light. pots filled with colorful flowers and green plants border the path neatly. a majestic pyramid rises in the distance under a twilight sky dotted with scattered clouds. twinkling city lights spread below the pyramid.','自然语言','rgba(255, 123, 2, .4)',1789793931,'a9ab831b-d7ea-4944-9db0-c636f2eac2a7',NULL);
