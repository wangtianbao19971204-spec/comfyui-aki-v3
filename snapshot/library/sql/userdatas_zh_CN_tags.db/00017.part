INSERT INTO "tag_tags" VALUES(284705,849,'char5：girl,hugging another''s arm (another''s dress shirt sleeve is injured with blood),half-closed eyes,sad,worried,tearing up,looking up,1.6::looking at viewer,facing up::,trembling,speech bubble,handwritten chinese text,text:你是笨蛋吗...?,','handwritten chinese text,text: “说‘你是笨蛋吗?’的各式各样的少女,','rgba(255, 123, 2, .4)',1789448957,'d69ba7e4-07a2-439a-8f9b-9ec916a2fd61','7472a6a5-c336-46a2-8aa5-f5bdb4d2c29f');
INSERT INTO "tag_tags" VALUES(284706,849,'char6：girl,full-face blush,shy,sweatdrop,hands on own cheeks,averting eyes,looking to the side,speech bubble,handwritten chinese text,text:“笨、笨、笨......你是笨蛋吗?!”,','handwritten chinese text,text: “说‘你是笨蛋吗?’的各式各样的少女,','rgba(255, 123, 2, .4)',1789448957,'d48cd0e0-6632-4849-89d8-166133bf0d60','7472a6a5-c336-46a2-8aa5-f5bdb4d2c29f');
INSERT INTO "tag_tags" VALUES(284707,849,'2::chibi,chibi only::,2::no pupils::,5::upper body::,5::4格漫画::,a four-panel manga-style scene in a cozy,magical cottage at sunrise.in the top-left panel,a close-up of a bubbling glass flask filled with shimmering blue liquid,tiny golden sparks rising from the surface.in the top-right panel,a young witch in a patched cloak holds a wooden stirring rod,gently swirling the potion with a focused,tender expression.in the bottom-left panel,she tips a single drop of the potion onto a wilted flower in a small pot on the windowsill.in the bottom-right panel,the flower instantly unfurls into a glowing,vibrant bloom,its petals catching the morning light,and the witch smiles softly.the overall mood is quiet,magical,and full of gentle wonder.','复生药水','rgba(255, 123, 2, .4)',1789448957,'5db9e60d-9653-49d5-87c9-ed8dbc5012d1','7472a6a5-c336-46a2-8aa5-f5bdb4d2c29f');
INSERT INTO "tag_tags" VALUES(284708,849,'panel 1—medium,top half,position: spans the entire top half of the page,from left edge to right edge.size: large (dominant establishing panel).camera: wide shot,eye level,from the pov character''s perspective.content: the girl is seen from behind,standing at the kitchen stove,cooking. she speaks without turning around.speech bubble: “饭也做了,妈妈也叫了.”','是谁你妈','rgba(255, 123, 2, .4)',1789448957,'27aa95a8-513f-43a2-ae01-2ed8b2ca883d','7472a6a5-c336-46a2-8aa5-f5bdb4d2c29f');
INSERT INTO "tag_tags" VALUES(284709,849,'panel 2— small,bottom-left cornerposition: bottom-left corner of the page,below panel 1.size: small,roughly square.camera: medium close-up,eye level,still pov.content: the girl has turned around to face the camera. her face is obscured by shadow. she points directly at the lens (the pov character).speech bubble: “你现在爱上了别的女人是什么意思,那我呢?”','是谁你妈','rgba(255, 123, 2, .4)',1789448957,'05da6b39-bedf-40cb-961a-3e3fba03b288','7472a6a5-c336-46a2-8aa5-f5bdb4d2c29f');
INSERT INTO "tag_tags" VALUES(284710,849,'panel 3 — medium,bottom-right,wider than tallposition: bottom-right area of the page,to the right of panel 2,also below panel 1.size: medium,horizontal rectangle (wider than it is tall).camera: close-up,slight high angle,pov.content: the girl lowers her head,fists clenched at her sides,shoulders trembling slightly. her face remains hidden.speech bubble: “合着我真成你妈妈了是吗?”','是谁你妈','rgba(255, 123, 2, .4)',1789448957,'da29f4c4-a51e-418f-93b0-9a56d4d5ed2e','7472a6a5-c336-46a2-8aa5-f5bdb4d2c29f');
INSERT INTO "tag_tags" VALUES(284711,849,'5::upper body::,5::4格漫画::,a four-panel manga-style scene in a cozy,warmly lit kitchen.in the top-left panel,a close-up of a small,delicate cake on a wooden plate,topped with a dollop of cream and a tiny tag that reads “eat me” in elegant script.in the top-right panel,a girl sits at the table,her finger hovering over the tag,a look of playful curiosity on her face before she brings a forkful of the cake to her lips.in the bottom-left panel,she suddenly shrinks rapidly,her clothes becoming loose,and now stands tiny on the tablecloth,looking around in surprise.in the bottom-right panel,from a low angle,she stands at the edge of the table,gazing up at a giant wooden chair beside the table,its legs towering like pillars,her expression a mix of awe and wonder.the overall mood is whimsical,slightly surreal,and filled with a sense of miniature adventure.','吃掉缩小蛋糕','rgba(255, 123, 2, .4)',1789448957,'e4a8fda5-720c-4504-8a0b-da13e547d0f6','7472a6a5-c336-46a2-8aa5-f5bdb4d2c29f');
INSERT INTO "tag_tags" VALUES(284712,849,'2::chibi,chibi only::,2::no pupils::,15::upper body::,5::4格漫画::,不要均分四格,a four-panel manga-style scene in a moonlit meadow.in the top-left panel,a worn but sturdy broomstick leans against an old oak tree,its twigs slightly frayed,with a small lantern tied to the handle.in the top-right panel,a girl in a flowy dress swings one leg over the broom,gripping it nervously but with sparkling eyes.in the bottom-left panel,the broom lifts a few inches off the ground,wobbling as she steadies herself,her hair lifted by a soft breeze.in the bottom-right panel,she soars upward,silhouetted against a full moon,a trail of silver dust streaming behind her,her face alight with joy.the overall mood is adventurous,exhilarating,and dreamy.','骑着扫帚奔向月亮','rgba(255, 123, 2, .4)',1789448957,'288267a7-ba98-402b-a8da-ae630e134979','7472a6a5-c336-46a2-8aa5-f5bdb4d2c29f');
INSERT INTO "tag_tags" VALUES(284713,849,'2::chibi,chibi only::,2::no pupils::,5::upper body::,5::4格漫画::,a four-panel manga-style scene in a sunny afternoon room.in the top-left panel,a close-up of a watering can spout with water droplets falling onto dry soil.in the top-right panel,the girl is seen from behind,leaning slightly forward,holding the watering can over a potted plant by the window.in the bottom-left panel,she sets the can down and gently touches a green leaf with her fingertip,examining it closely.in the bottom-right panel,she stands back,hands on her hips,and smiles softly at the row of healthy plants basking in the sunlight.the overall mood is gentle,nurturing,and peaceful.','浇灌花草','rgba(255, 123, 2, .4)',1789448957,'5fe2a142-2354-40dd-82ef-3f5e2cec0cf3','7472a6a5-c336-46a2-8aa5-f5bdb4d2c29f');
INSERT INTO "tag_tags" VALUES(284714,849,'2::chibi,chibi only::,2::no pupils::,5::upper body::,5::4格漫画::,a four-panel manga-style scene during golden hour.in the top-left panel,a white t-shirt sways gently on a clothesline,catching the warm orange light.in the top-right panel,the girl reaches up,unclipping the shirt from the line,her arms raised,her face partly lit by the setting sun.in the bottom-left panel,she folds the shirt over her arm,then reaches for another piece — a soft towel — with unhurried movements.in the bottom-right panel,she holds the folded pile against her chest,looking out at the warm sky before turning to go inside.the overall mood is unhurried,tender,and wrapped in the softness of the evening.','收下晾晒衣物','rgba(255, 123, 2, .4)',1789448957,'78dbfea2-dcd4-454b-81da-5f27224b37e8','7472a6a5-c336-46a2-8aa5-f5bdb4d2c29f');
INSERT INTO "tag_tags" VALUES(284715,552,'ultra complexity,vrchat,2::loli,petite::,画面是一张高完成度的日系二次元3d渲染风角色插画,整体采用柔和的半写实材质、精细布料纹理、浅景深以及非常明显的暖色逆光效果.主色调集中在奶油白、浅金、柔粉、棕灰、深灰黑和少量暗红色之间,人物面部与头发被偏橙黄色的夕阳或室内暖光照亮,形成柔和的轮廓光和大片高亮.构图为竖向近距离上半身肖像,人物位于画面中央偏右,从头顶到腰部附近占据绝大部分画面,背景则被强烈虚化,仅保留模糊的深色木质结构、座椅或墙面,以及左上和后方的大面积暖黄色亮光.画面中只有一名女性化动漫角色,肤色白皙偏暖,体型纤细,身体略向画面左侧倾斜,头部低垂并稍稍转向观察者,右手从画面右侧抬起,食指竖直向上,其余手指大多弯曲在宽大的袖口内,形成一个轻松、提示或俏皮的手势.她拥有非常长的银白色至奶油白色头发,发丝细腻柔顺,头发表面有强烈的金色边缘光.额前是长而分层的斜刘海,部分覆盖眉眼;两侧脸颊旁有卷曲的短发和细长发束,后方长发垂至胸腹以下.左侧靠近胸前的一束头发被编成松散辫子,并在下方扎紧,辫子周围还点缀有浅色花朵或小型装饰.她头顶戴着一顶深棕灰至黑色的鸭舌帽,帽体带细密织物或网状纹理,帽冠顶部呈现两侧向上突出的尖角结构,使整体轮廓类似猫耳帽.帽檐向前延伸并遮住部分额头,边缘能看到清晰的双排缝线.帽子正面别着两个圆形徽章:左侧较大的徽章有浅色外圈、红色环状图案和中央黑色旋涡/眼状符号,右侧较小徽章内部也有红黑色圆形标记.角色眼睛呈粉红至浅玫瑰红色,虹膜带渐变和细小高光,上睫毛较深,眼睛半睁并略微向下看,整体眼神柔和、慵懒.脸颊覆盖明显的浅粉红晕,鼻子极简,嘴巴微微张开并向上弯曲,露出柔和的浅色口腔或牙齿亮部,整体表情显得温柔、亲近、略带狡黠.服装层次非常复杂,内层是白色翻领衬衫,领口系一条暗红至砖红色领带,领带表面可见淡色花纹或斑驳装饰;衬衫外侧叠加浅棕灰色背心或马甲结构,胸前横跨一条深色带子,并装饰多枚小型花朵、珠状或宝石状饰件,其中有浅紫、灰紫和金属色细节.外层是一件深灰黑色宽松夹克或大衣,衣料厚重,袖子非常宽大,表面带细密织物纹理、反光和局部刺绣或蕾丝状图案.衣服边缘和肩臂位置还结合了浅灰、米白和棕色格纹布料,尤其右侧胸前与袖口附近能看到明显的格子蝴蝶结或带状装饰.人物胸部被层叠衬衫、马甲和外套完整覆盖,没有可见裸露敏感部位.腰部下方只出现少量深色衣料和束带结构,画面在躯干下段附近裁切,因此下半身、腿部和鞋子均未出现.右侧抬起的手从极宽的深色袖口中伸出,手指纤细,皮肤受到暖光照射而呈粉橙色高光;食指明确向上竖起.背景没有清晰可辨认的具体家具细节,但能够看到深棕色横向木质纹理或座椅靠背,以及后方较暗的墙面/室内结构;左后方存在模糊的深色轮廓和一片非常明亮的暖黄色光源,可能来自窗户或夕阳.整体光线带有强烈的黄金时刻质感,头发、帽檐、脸颊和衣物边缘均被柔暖光线包围,同时背景因浅景深而显得朦胧,形成精致、温暖、略带复古与都市休闲感的角色肖像氛围.','','rgba(255, 123, 2, .4)',1789448957,'69173e03-7ecf-47ad-ad4f-8030abe6278e','ea1e6258-6f85-4b83-aefa-4df9ce040907');
