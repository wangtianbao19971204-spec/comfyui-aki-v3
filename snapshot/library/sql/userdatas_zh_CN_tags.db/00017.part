INSERT INTO "tag_tags" VALUES(285597,75,'1boy,1girl,cowboy shot,lying on grass,from above,smile,In a secluded grove deep within a forest,where sunlight filters down in warm,hazy shafts through the dense emerald canopy,boy holds girl in a tender embrace. The light dapples the forest floor,illuminating floating dust motes and creating an ethereal glow around them,isolating them in a pocket of profound quietude.the boy,his usual sharp demeanor softened by an intense,protective tenderness,leans down to press a soft,lingering kiss on girl''s forehead.','多人互动','rgba(255, 123, 2, .4)',1789470947,'080ee0c0-10fe-4896-9c41-deb3af14a1b7','48b28d76-22bc-45ce-bc70-9493d51250ce');
INSERT INTO "tag_tags" VALUES(285598,75,'girl,cradled securely in his arms,appears serene with her eyes closed and a soft,contented smile gracing her lips,fully immersed in the warm intimacy of the moment. Her light-colored,nature-themed attire seems to absorb the gentle light,while boy''s darker clothing provides a contrasting depth. The air is still and warm,filled only with the distant,muted sounds of the forest,heightening the sense of a private world shared only by them. The scene is suffused with a gentle,almost sacred intimacy,hinting at a deep,complex bond that flourishes in this sun-kissed,hidden sanctuary.','多人互动','rgba(255, 123, 2, .4)',1789470947,'7f572129-7ab1-41ba-af0f-419615858278','48b28d76-22bc-45ce-bc70-9493d51250ce');
