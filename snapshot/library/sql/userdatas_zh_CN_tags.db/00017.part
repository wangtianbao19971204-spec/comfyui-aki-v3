INSERT INTO "tag_tags" VALUES(286068,864,'druidic circle,performing ritual in ancient clearing,chanting,hands raised towards stonehenge,robes of natural fibers,antler headpieces,mossy megaliths arranged in circle,old growth forest,beams of moonlight piercing fog,ethereal green glow from ground,mystical and primitive,low angle,wide shot,mysterious','自然语言','rgba(255, 123, 2, .4)',1789470947,'ef109a7a-2002-4337-b76a-88e625fac2fa','67a73ca2-1094-486f-9ad8-25f9b4bcfaa7');
INSERT INTO "tag_tags" VALUES(286069,864,'1girl,1.5::walking slowly through a desolate battlefield littered with countless corpses::,1.5::expressionless with a hollow blank stare::,1.4::carefully wiping a blood-stained dagger with a white torn cloth while moving::,1.3::blood splashing across her cheek and tattered clothes::,1.3::one hand gripping the hilt while the other meticulously cleans the steel blade::,1.2::hair fluttering in the cold post-battle wind::,1.1::stepping over broken swords and fallen soldiers::,massacre,1.6::field of dead bodies stretching to the horizon under a heavy grey sky::,1.5::piles of tangled limbs and discarded armor in the background::,1.4::large pools of dark blood reflecting the dim light on the muddy ground::,1.3::faint smoke rising from smoldering ruins in the distance::,1.2::desaturated and gritty environment::,1.5::harsh low-key lighting with deep dramatic shadows::,1.4::cold overcast daylight creating a somber atmosphere::,1.4::strong rim lighting highlighting her silhouette against the dark carnage::,1.3::specular glints on the partially cleaned dagger blade::,1.2::volumetric fog and dust swirling around her feet::,cinematic,dark fantasy,outdoors','自然语言','rgba(255, 123, 2, .4)',1789470947,'89af4f52-fe49-4fd4-b239-6a6e9fe4e137','67a73ca2-1094-486f-9ad8-25f9b4bcfaa7');
INSERT INTO "tag_tags" VALUES(286070,864,'1girl,1.5::huddled on a rusted and peeling metal bench::,1.4::clutching a worn leather suitcase tightly to her chest::,1.2::knuckles white from gripping her bag::,1.2::breath forming a faint cold mist in the stagnant air::,1.5::dilapidated abandoned train station platform::,1.4::cracked concrete floors with tall withered weeds growing through the fissures::,1.4::rusted railway tracks disappearing into a thick unnatural fog::,1.3::shattered glass shards littering the ground::,1.3::walls covered in layers of grime and cryptic dark stains::,1.2::broken clock frozen at an impossible hour::,1.6::sickly flickering overhead fluorescent light casting long erratic shadows::,1.5::harsh high-contrast chiaroscuro lighting::,1.4::dense eerie mist crawling along the platform edge::,1.4::deep oppressive shadows hiding distorted shapes in the background::,1.3::faint cold moonlight filtering through a jagged hole in the ceiling::,1.2::unseen eyes watching from the darkness::,horror,ominous atmosphere,dark palette,cinematic,outdoors,night','自然语言','rgba(255, 123, 2, .4)',1789470947,'11d884d1-7bbd-4c64-95c3-351da7c7f7ba','67a73ca2-1094-486f-9ad8-25f9b4bcfaa7');
INSERT INTO "tag_tags" VALUES(286071,864,'a high-resolution,vibrant digital collage featuring the girll,integrated with various retro and modern music technology devices against a black background.depicted in an anime style . her face is positioned in the center-right,looking directly at the viewer with a glossy.','自然语言','rgba(255, 123, 2, .4)',1789470947,'963d20c2-e025-429a-9db1-3a5a00958e2f','67a73ca2-1094-486f-9ad8-25f9b4bcfaa7');
