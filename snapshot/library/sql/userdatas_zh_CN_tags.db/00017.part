INSERT INTO "tag_tags" VALUES(286058,864,'翻译：一名女性，身穿修身丝绸衬衫，搭配定制阔腿裤，尖头乐福鞋，佩戴珍珠项链，手提结构感手提包，摆出随意的高级时尚姿势，姿势可动可静，具有时尚杂志风格，自然的肢体动作，多样的肢体姿势，堪比杂志大片的构图，高级时尚摄影棚背景，无缝背景布，戏剧性的聚光灯效果，时尚杂志排版，时尚杂志标题，光泽感文字叠加，醒目的文字，3D渲染文字，手写时尚标签，随意的面部表情，展现多种情绪。','自然语言','rgba(255, 123, 2, .4)',1789470947,'51029bdc-8037-491f-9f8f-d4fb527f8070','67a73ca2-1094-486f-9ad8-25f9b4bcfaa7');
INSERT INTO "tag_tags" VALUES(286059,864,'1girl,christmas night,dull lifeless fish eyes with heavy dark circles,subtle weary,expression,mouth slightly downturned,wearing crooked red santa hat with white pom-pom drooping over one eye,sitting inside overflowing grimy dumpster filled with torn wrapping paper,crushed gift boxes,broken ornaments and wilted mistletoe,upper body emerging from trash pile,one bare hand weakly reaching upward toward falling snowflakes as if asking for help,fingers trembling and smudged with soot,pale skin with cold blush on cheeks,messy long hair partially hidden under hat with strands sticking out,tattered oversized christmas sweater with faded reindeer pattern slipping off one shoulder,striped candy-cane thigh-high socks torn at knees,surrounding scene of snowy abandoned alley at night,faint multicolored christmas lights flickering weakly on distant buildings,scattered empty gift boxes and snapped in half,single glowing red ornament rolling on ground,cold blue moonlight mixing with warm dying fairy light glow,gentle snow falling and melting on her skin,cinematic low-angle shot from outside the dumpster looking up to emphasize isolation and despair,shallow depth of field with dreamy bokeh on background lights,muted color palette dominated by cold blues and grays with selective red and green christmas accents,melancholic lonely atmosphere,subtle film grain and light frost particles in air','自然语言','rgba(255, 123, 2, .4)',1789470947,'5e208bec-86a7-42f8-8034-9c4f5490a501','67a73ca2-1094-486f-9ad8-25f9b4bcfaa7');
