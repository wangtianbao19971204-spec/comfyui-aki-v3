INSERT INTO "tag_tags" VALUES(285974,864,'a striking demon girl with pale skin,short silvery hair,and golden eyes lounges languidly on a luxurious sofa,her black dragon wings elegantly draped over the cushions. she wears an elaborate monochrome dress with voluminous ruffles and delicate tassel details,her long legs clad in white thigh-high stockings adorned with ornate garters. one hand gracefully holds a crystal wine glass filled with deep red wine,her lips slightly parted in a subtle,alluring smile as she gazes toward the viewer with a teasing,half-lidded look. her black horns and spiked halo frame her face,while her tail curls lazily along the sofa''s edge. the scene is bathed in soft,diffused light,highlighting the glossy textures of her outfit and the rich velvet of the sofa. the composition is cinematic,with a low,intimate camera angle that captures her relaxed,seductive pose and the inviting atmosphere,set against a minimalist,elegant background.','自然语言','rgba(255, 123, 2, .4)',1789470947,'77e6994f-8efe-4871-af85-ce5019926bd6','67a73ca2-1094-486f-9ad8-25f9b4bcfaa7');
