INSERT INTO "tag_tags" VALUES(343169,864,'原Tag：a winding dirt road curves through vibrant green fields and golden rice paddies under soft sunlight. distant rolling mountains blend with a clear azure sky dotted with fluffy white clouds. wooden power poles line the roadside casting slender shadows across sunbaked earth and scattered gravel. warm golden hour light washes over the landscape,creating sharp contrasts between emerald vegetation and amber crops.','自然语言','rgba(255, 123, 2, .4)',1789793931,'c2b0b034-e2f1-4bf1-8e7e-f91a997ee5d4',NULL);
