INSERT INTO "tag_tags" VALUES(285899,864,'a digital illustration in a dreamy,magical style,it features a young magical girl soaring through the night sky. the background is a deep,star-speckled sky with wisps of dark clouds and faint,glowing constellations scattered across the canvas','自然语言','rgba(255, 123, 2, .4)',1789470947,'4b7e72f6-9eb8-4879-a0b2-0547e44e23f9','67a73ca2-1094-486f-9ad8-25f9b4bcfaa7');
INSERT INTO "tag_tags" VALUES(285900,864,'she wears a layered pink dress that flutters in the air,with flowing ribbons and frilled sleeves glowing softly under the moonlight. her expression is resolute and fierce,her bright red eyes locked forward.','自然语言','rgba(255, 123, 2, .4)',1789470947,'e6704d7f-11c5-41ee-8a17-a2f6c97db517','67a73ca2-1094-486f-9ad8-25f9b4bcfaa7');
INSERT INTO "tag_tags" VALUES(285901,864,'the girl has long,silver-white hair streaming behind her as she flies,her arms outstretched. behind her are a pair of translucent,multicolored wings shaped like shifting,flame-like butterflies,made of iridescent magical fire in hues of violet,blue,and pink.','自然语言','rgba(255, 123, 2, .4)',1789470947,'f1388873-dd4d-448f-9713-ba0c88fceb74','67a73ca2-1094-486f-9ad8-25f9b4bcfaa7');
INSERT INTO "tag_tags" VALUES(285902,864,'in her hand,she holds a golden wand that radiates power — the tip glows with intense magical energy,as it fires a brilliant,rainbow-colored beam of light downward. the beam twists and pulses,lighting up the darkness with a sense of power and urgency.','自然语言','rgba(255, 123, 2, .4)',1789470947,'34d06125-16dd-4c0b-bddc-58a7e84e91b3','67a73ca2-1094-486f-9ad8-25f9b4bcfaa7');
INSERT INTO "tag_tags" VALUES(285903,864,'the overall artwork is rich in detail,with sharp,dynamic lines that emphasize motion,magic,and emotion. the strong contrast between the dark background and the vivid magical effects makes the figure stand out with dramatic intensity,capturing the spirit of a determined magical heroine in the heat of battle.','自然语言','rgba(255, 123, 2, .4)',1789470947,'361b45af-28e4-4e12-88bf-33ae0fab512b','67a73ca2-1094-486f-9ad8-25f9b4bcfaa7');
