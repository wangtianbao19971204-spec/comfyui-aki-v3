INSERT INTO "tag_tags" VALUES(285827,864,'anime scene,dynamic angle,motion feel,aerial view,very high above,a anime girl,wearing a white short-sleeve shirt and a grey sweater vest,black pants,hanging on a drone in midair. her arms are overhead and she''s gripping landing skids of the drone with both arms. she''s a little surprised. the time is night,and skyline and city lights are underneath her.','自然语言','rgba(255, 123, 2, .4)',1789470947,'b8daa939-8616-414b-ab66-e293b8f96786','67a73ca2-1094-486f-9ad8-25f9b4bcfaa7');
INSERT INTO "tag_tags" VALUES(285828,864,'a dynamic fantasy illustration with a cool aesthetic,rendered with painterly textures and subtle brushwork. features an eerie,surreal atmosphere,employing dramatic,high-contrast lighting like rim light or backlighting,and glowing elements to evoke a mythic,poignant narrative.1girl,solo,sitting on a throne crudely fashioned from asteroid fragments and spaceship wreckage amidst a debris field in space,same petite loli appearance (eyes looking distant/bored),hugging a worn-out teddy bear tightly,wearing a slightly torn but still recognizably cute dress,vast emptiness of space surrounding her,subtle glow emanating from her body,capturing a moment of quiet solitude after destruction,melancholic atmosphere,chiaroscuro lighting emphasizing loneliness and power,detailed texture on bear and wreckage.','自然语言','rgba(255, 123, 2, .4)',1789470947,'99a9e8e9-a39d-48d9-a365-b54545105f46','67a73ca2-1094-486f-9ad8-25f9b4bcfaa7');
