INSERT INTO "tag_tags" VALUES(285922,864,'翻译：屡获殊荣的电影海报，单色蓝白色调，极浅的景深，极端前景中的失焦轮廓（运动模糊），超详细的遥远星系投影重叠图形，厚重的胶片颗粒叠加，迷幻的光迹，多重曝光效果，高对比度照明（破碎的阴影+吹亮），镜头眩光条纹，乳剂划痕纹理，抽象墨水渗色边缘，梦幻氛围，80％负空间，电影宽高比2.35：1，微妙的英文排版片段（“lumière”/“silence”），凡士林镜头模拟，模仿星星的散景球体，柔焦扩散滤镜，轮廓边缘的重影效果','自然语言','rgba(255, 123, 2, .4)',1789470947,'43b38788-2c84-4761-8c52-a7a1a4b7ef02','67a73ca2-1094-486f-9ad8-25f9b4bcfaa7');
