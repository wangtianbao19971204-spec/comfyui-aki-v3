INSERT INTO "tag_tags" VALUES(285896,864,'an awe-inspiring necromancer stands in a dark,foreboding wasteland,draped in tattered black and emerald-green robes glowing with arcane energy. his skeletal hands hold a twisted staff radiating pulsating green light,as streams of vibrant green magic swirl and erupt into the air,forming ghostly apparitions and skeletal figures. the necromancer''s eyes blaze with an eerie glow,while the cracked earth beneath him glows with ancient runes. a swirling vortex of green mist and energy surrounds him,casting eerie shadows under a stormy sky lit by flashes of lightning. highly detailed,cinematic lighting,dark fantasy aesthetic,with dramatic contrasts and dynamic magical effects.','自然语言','rgba(255, 123, 2, .4)',1789470947,'c94d1de9-d16c-4edc-9a90-6f59490bd436','67a73ca2-1094-486f-9ad8-25f9b4bcfaa7');
INSERT INTO "tag_tags" VALUES(285897,864,'a dynamic illustration featuring a confident,female figure adorned in intricate black flowing black cloak. she stands boldly,one arm raised,as tendrils of dark energy swirl around her. the background is a surreal,muted landscape with abstract forms and a hint of a lich dragon''s silhouette,creating a mystical atmosphere. the lighting is dramatic,emphasizing her fierce expression and the details of her attire.','自然语言','rgba(255, 123, 2, .4)',1789470947,'429f6b98-3ebc-4735-88fe-4dc87b8ea324','67a73ca2-1094-486f-9ad8-25f9b4bcfaa7');
