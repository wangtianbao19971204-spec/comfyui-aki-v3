INSERT INTO "tag_tags" VALUES(284643,76,'浅水水底的焦散纹理泛着彩虹般的渐变色光泽,1girl,original,mermaid,fish tail,pov,pov hands,holding fishing rod,fishing rod,fishing line,fishhook,open mouth,pointing at own mouth,teeth,furrowed brows,looking at viewer,upper body,shell bikini,wet hair,wet,water,partially submerged,splashing,water drop,bucket,fish,wooden dock,sunlight,sun,sparkling water,lens flare,depth of fieldwhite hair,第一人称视角从木质码头边缘往下看,左手握着鱼竿,一个美人鱼上半身从水面探出,她张着嘴用一只手指着自己嘴角的鱼钩,可怜巴巴地仰头看向镜头,贝壳比基尼,她的鱼尾在水面下隐约可见呈模糊的深色剪影,水面波光粼粼反射正午阳光,码头木板的纹理在画面底部近景处清晰可见,左下角一个铁皮水桶里有两三条小鱼在扑腾,桶边溅出的水渍浸湿了木板,阳光在水面制造大片高光和lens flare打在美人鱼脸侧,她的一只手搭在木板上,另一只手指着自己的嘴巴,half-closed eyes,平静的表情,hair between eyes,long hair,-1::black border::,2::pov holding fishing rod,','钓上美人鱼','rgba(255, 123, 2, .4)',1789448957,'9a97ce1b-90f6-4f73-9280-b7585fc806c6','86b67756-d071-48f1-aa7f-4f03b90d9557');
INSERT INTO "tag_tags" VALUES(284644,76,'1girl,solo,sitting on floor,looking up,surprised expression,reaching out a hand nutcracker,giant,life-sized,kneeling on one knee,bowing,taking her hand,offering a handenvironment & composition: two shot,indoors,cozy living room,in front of a christmas tree,piles of unwrapped presents,morning light,floor-level viewlighting & color: soft lighting,morning sun,light from christmas tree lights,gentle shadows,warm and soft,bokeh from tree lights,lens flaregold theme,red theme,soft colorson christmas morning,in a cozy living room bathed in soft sunlight,a girl sits on the floor amidst unwrapped presents. she looks up with a surprised and delighted expression as a life-sized nutcracker,seemingly having just come to life,kneels before her and gently takes her offered hand. the scene is viewed from a low,floor-level angle,making the moment feel intimate and magical. the twinkling lights from the christmas tree in the background create a beautiful,soft-focus bokeh,adding to the warmth and wonder of the scene.3::cover hand::,','胡桃夹子邀请','rgba(255, 123, 2, .4)',1789448957,'2c6142a4-fee8-4048-a342-5880f8b5f721','86b67756-d071-48f1-aa7f-4f03b90d9557');
