INSERT INTO "tag_tags" VALUES(285210,97,'日蚀收割者arm strap,bare shoulders,black dress,black hands,chain,cowboy shot,cracked skin,empty eyes,gradient skin,high collar,holding polearm,hole on body,hood up,hooded dress,impaled,pale skin,rain,side slit,solar eclipse,straight-on','其他','rgba(255, 123, 2, .4)',1789470947,'785eb510-fbda-4468-bfed-7e8b561b246c','d13ee72e-dbd6-45bb-bb3b-e39f83c65ab7');
INSERT INTO "tag_tags" VALUES(285211,86,'wide shot：广角，缩小人物增加背景展示cowboy shot：人物七分身镜头fisheye：鱼眼镜头，能出非常夸张的透视close-up：特写，视画风而定具体人物缩放大小，一般可以有效解决图糊的问题head/feet+out of frame： 头/脚出框身体部位+focus：重点表现某一身体部分，另有solo focus，效果与close-up类似dutch angle：荷兰角（不）斜角镜头，让你的景色看起来没那么正vanishing point：远景透视，尚未测试，效果不确定panorama：全景，比wide shot效果更明显pov(first-person view)：第一人称，无需多言foreshortening：正前缩距，一定程度有效，增强正面透视和靠近效果perspective：透视，优化透视效果','视角与打光','rgba(255, 123, 2, .4)',1789470947,'b1cee8d4-53eb-47f6-adba-eaf49b4558a5','6b593892-36a2-4137-b65f-5efff7ef027f');
INSERT INTO "tag_tags" VALUES(285212,86,'light leaks：漏光，指摄像时的散光，ai效果一般','视角与打光','rgba(255, 123, 2, .4)',1789470947,'c49470cf-62d9-46ec-a255-3c0ce8f614c5','6b593892-36a2-4137-b65f-5efff7ef027f');
INSERT INTO "tag_tags" VALUES(285213,86,'sunlight：阳光，此外存在月光（moonlight）和星光（starlight），不过此二者效果相对一般','视角与打光','rgba(255, 123, 2, .4)',1789470947,'1ade7d5e-3eb7-4150-a83c-eb48308b4f9b','6b593892-36a2-4137-b65f-5efff7ef027f');
INSERT INTO "tag_tags" VALUES(285214,86,'bokeh：散景，表示在景深较浅的摄影成像中，落在景深以外的画面，会有逐渐产生松散模糊的效果，与blurry background效果类似','视角与打光','rgba(255, 123, 2, .4)',1789470947,'a97fd14f-1d1e-4f67-80c9-b21dcb687552','6b593892-36a2-4137-b65f-5efff7ef027f');
INSERT INTO "tag_tags" VALUES(285215,86,'lens flare：镜头光晕，一种炫光，ai有一定效果，具体视画风而定','视角与打光','rgba(255, 123, 2, .4)',1789470947,'1688a6cf-db7e-47a4-97a8-ff8b9c136fbb','6b593892-36a2-4137-b65f-5efff7ef027f');
INSERT INTO "tag_tags" VALUES(285216,86,'strong contrast：强对比度，与高对比度high contrast相同，不赘述','视角与打光','rgba(255, 123, 2, .4)',1789470947,'38ed512b-d0da-44b7-b6fb-33ec58241ee3','6b593892-36a2-4137-b65f-5efff7ef027f');
INSERT INTO "tag_tags" VALUES(285217,86,'light and shadow：光影，一般是增加了阴影，实际就是单shadow效果','视角与打光','rgba(255, 123, 2, .4)',1789470947,'50686d80-dac8-49fc-be03-f4cf2fa2990b','6b593892-36a2-4137-b65f-5efff7ef027f');
INSERT INTO "tag_tags" VALUES(285218,86,'monochrome：单色，尽量减少其他颜色表现，与xxx theme搭配使用，单走一般是黑白灰效果','视角与打光','rgba(255, 123, 2, .4)',1789470947,'6119b810-f7dd-40c6-9151-fa6ee084ba6e','6b593892-36a2-4137-b65f-5efff7ef027f');
