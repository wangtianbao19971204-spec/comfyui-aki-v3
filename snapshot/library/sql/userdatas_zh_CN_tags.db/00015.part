INSERT INTO "tag_tags" VALUES(256791,464,'2::artist:manzai_sugar::,1::artist:ter_(otokoter)::,1:: artist:Shigure_S:: , year 2026,best quality,very aesthetic,absurdres,masterpiece, 

intense anime-style digital illustration of a turquoise-haired female singer standing powerfully at the center in a wide-legged stance, gripping a handheld microphone close to her mouth and singing with overwhelming emotion, narrowed eyes, an open mouth, and a fierce, electrified expression; her hair itself is completely transformed into a monumental symmetrical waveform spectrum, with no conventional twin tails or ordinary flowing locks, expanding directly from both sides of her head into enormous teal frequency fields composed of dense vertical spikes, jagged amplitude peaks, oscillating contours, layered spectral bands, and elongated dripping signal lines, unmistakably both her living hair and a visualization of the force of her voice; the waveform hair spreads across nearly the entire canvas and converges sharply behind her head, creating explosive bilateral symmetry; she wears a dark cropped jacket over a white top with turquoise accents, a short dark skirt, thigh-high black stockings, and tall black boots, while thin turquoise strands of spectral hair curl around her body and trail across the floor; centered full-body framing, stark white negative space, teal and dark turquoise waveform-hair masses, rough expressive sketch lines, energetic ink textures, hand-drawn manga aesthetic, limited teal, black, gray, and white palette, extreme graphic contrast, raw motion, sound made visible, and an emotionally overwhelming performance atmosphere.
