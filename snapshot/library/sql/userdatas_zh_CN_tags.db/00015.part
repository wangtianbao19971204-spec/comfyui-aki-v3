<artwork>
  <rendering_and_art_style>
    Clean modern anime digital illustration with semi-soft cel-shading and delicate warm-toned linework (#683A35). Smooth airbrush shading blended with sharp occlusion edges, soft painterly hair texture, and translucent skin rendering with subtle subsurface scattering.
  </rendering_and_art_style>

  <color_system>
    <palette>
      <color role="Hair and Fur" hex="#F7D279" secondary="#E8A94A" shadow="#C47E3B"/>
      <color role="Iris" hex="#F5B438" highlight="#FFFFFF" pupil="#FFFFFF"/>
      <color role="Skin" hex="#FFF1EC" blush="#F38C96"/>
