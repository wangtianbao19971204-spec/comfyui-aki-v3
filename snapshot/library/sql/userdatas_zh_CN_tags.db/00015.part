INSERT INTO "tag_tags" VALUES(257449,465,'artist:sos_adult, flat color, soft shading, cel shading, year 2024, year 2025, year 2026, best quality, amazing quality, very aesthetic, highres, incredibly absurdres, nsfw, uncensored, 2girls, 1.2::inside an mma octagon cage, chain-link fence, black cage padding, arena lights, white mat ::, sweaty, two separate bodies, 1.8::the two women are exactly the same height and the same build, Momo is a full grown adult woman just as tall as Marina, her head the same size as Marina''s head, her torso as long as Marina''s torso, adult proportions with long adult limbs ::, 1.6::both bodies drawn at the same scale, no forced perspective shrinking her, Momo is not farther away, she reads just as large as Marina ::, yuri, femdom, 1.8::Momo has been turned completely upside down and is held vertical, head down, her whole body a straight vertical line rising up from the mat ::, 1.8::Marina is sitting on the mat leaning over at an angle, her upper body tilted well off vertical and her weight thrown onto one hip, not sitting bolt upright ::, 1.85::she has Momo''s head and neck locked between her thick thighs in a headscissors, her thighs crossed shut and cranked tight around Momo''s throat, the muscles in them flexed hard, the soft flesh of her thighs bulging out around the trapped neck and Momo''s neck visibly compressed and squeezed narrow between them, a crushing choke, and that grip is the only thing holding Momo inverted ::, 1.75::high above them Momo''s legs are hauled apart into a full split, a straight line from one ankle to the other, her crotch stretched wide open toward the camera ::, 1.7::Momo is turned to face outward toward the fence and the camera, the front of her body toward the viewer and her back toward Marina ::, 1.8::there is exactly one handcuff in this picture and it is on Momo''s left ankle only, its other end anchored to the cage fence with the chain pulled taut, so that one leg is held out to the side by the chain alone with nobody touching it ::, 1.7::Momo''s right ankle is completely bare, no cuff and no chain on it at all ::, 1.85::Marina has both of her hands on that one bare uncuffed right leg, both hands closed around the same leg one above the other, and she is hauling that single leg the opposite way with all her strength to wrench the split wider, both of her hands clearly visible on it ::, 1.7::Marina never touches the cuffed leg, both of her arms reach to the same side ::, 1.6::Momo''s inner thighs stretched taut with the tendons standing out, her hips strained to the limit, her toes curled ::, 1.6::Marina looking up along her with sleepy half lidded eyes and a lazy little smile, completely unhurried, not straining at all ::, 1.75::ahegao, Momo''s face showing between Marina''s thighs, her eyes rolled back, her tongue lolling out of her open mouth, drooling, tears running from the corners of her eyes and a thin line of snot at her nose, a heavy blush across her cheeks, her brows drawn up, blissed out ::, 1.75::the crown of Momo''s head is pressed down flat against the canvas with her weight bearing on it, her neck folded and her scalp squashed against the floor, a dark contact shadow pooled tight underneath her head where it meets the mat ::, 1.6::her long pink hair pooled and fanned out flat across the canvas underneath her, lying on the floor ::, 1.7::the shot is taken from outside the cage looking in, and the chain-link fence stands between the camera and the two women, so the wire mesh passes in front of their bodies and cuts across them, the diamond wire crossing over their skin and partly hiding them, they are seen through the fence, the wire sharp and in focus in the foreground while they are behind it ::, 1.4::full body, the two of them filling the frame, dramatic perspective ::','韩网精选 0405','rgba(255, 123, 2, .4)',1789444510,'1957fcd1-a994-47e8-8263-d92ff053c65c','a575c2b5-fffa-4329-97f3-22cd08039b2f');
