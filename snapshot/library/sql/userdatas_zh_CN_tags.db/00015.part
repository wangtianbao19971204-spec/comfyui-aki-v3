INSERT INTO "tag_tags" VALUES(257888,468,'0.85::artist:mignon::, 0.75::artist:onineko::, 0.7::artist:ke-ta::, 0.65::artist:quasarcake::, 0.6::artist:ask (askzy)::, 0.55::artist:nixeu::, 0.5::artist:rella::, 0.45::artist:modare::, 0.4::artist:raika ken::,
year 2025, year 2026, loli, young, childish face, round face, large eyes, small breasts, clean lineart, detailed lineart, soft shading, slight impasto, subtle oil painting (medium), glossy skin, shiny skin, oily skin, bright lighting, glowing light, light particles, detailed fabric, anime coloring, very aesthetic, best quality, ultra-detailed, A_striking_surreal_illustration_using_flat_colors_and_graphic_design_elements._On_the_left_stands_a_girl_with_short_pink_hair_that_billows_upward_and_seamlessly_transforms_into_massive, stylized_red_cumulus_clouds_against_a_pale_sky._She_wears_a_large_blue_cape_or_coat_that_does_not_end_in_fabric, but_rather_morphs_directly_into_a_dark_blue_silhouette_of_a_bustling_night_city._Within_the_dark_blue_expanse_of_her_clothing-turned-cityscape, a_bright_red_Ferris_wheel_glows_neon, alongside_the_geometric_shapes_of_skyscrapers, a_bridge, and_a_passing_train_with_lit_windows._The_boundary_between_the_character_and_the_environment_is_completely_dissolved_in_a_double_exposure_effect._The_color_palette_is_strictly_limited_to_shades_of_deep_blue, teal, vibrant_red, and_pale_white, creating_a_high-contrast_and_dreamlike_visual_metaphor_where_the_girl_is_one_with_the_urban_landscape, very aesthetic, masterpiece, no text','DC 180','rgba(255, 123, 2, .4)',1789444949,'ad2324d3-26b8-4430-96eb-8bd6345e2a3c','3cdea03f-db10-40d2-b4a3-c6d3d4621335');
