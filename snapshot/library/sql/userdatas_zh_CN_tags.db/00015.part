INSERT INTO "tag_tags" VALUES(265648,73,'1girl,sitting on a subway seat that is completely overgrown with a lush bed of pink,yellow,and purple wildflowers. the entire floor of the train carriage is a pool of crystal-clear turquoise water with gentle ripples,where several bright orange koi fish are swimming. long green vines and leafy plants hang down from the metal handrails and the ceiling,framing the interior like a floating garden. large windows on both sides reveal a vast,cloudless blue sky and a distant horizon. bright,natural sunlight streams through the glass,creating shimmering light patterns on the water''s surface. she has a serene expression and is dipping her bare feet into the water while looking out the window.','浸水列车','rgba(255, 123, 2, .4)',1789452709,'81709262-eb76-4bd1-8de0-6197808fe921','4cd4a244-9e15-48b2-8f10-85d18634105d');
