INSERT INTO "tag_tags" VALUES(265258,72,'solo,looking at viewer,closed mouth,smile,cowboy shot,three-quarter view,off-center right,mirror,broken glass,crack,different reflection,clasped hands,light particles,sparkle,from behind,looking back,a tight medium close-up at eye level frames the girl on the right side of the composition while an ornate oval mirror fills the left half. she turns slightly toward the viewer with a soft,cheerful smile,her expression warm and composed,while the figure inside the mirror faces forward with a darker,more sinister gaz. the two do not behave like a perfect reflection; instead,they appear as separate presences sharing the same face yet conveying different emotions. her raised hand aligns with the glass between them as glowing orange cracks streak downward,casting warm highlights across their features and heightening the contrast between the bright,friendly exterior and the ominous counterpart within the shadowed mirror.','镜中背离','rgba(255, 123, 2, .4)',1789452319,'a63ae56d-907b-49e4-bf98-61ccf0907778','56e1fca3-2ac6-4fa7-abf4-69603eda55db');
