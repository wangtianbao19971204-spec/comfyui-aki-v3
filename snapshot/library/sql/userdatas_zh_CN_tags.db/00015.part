INSERT INTO "tag_tags" VALUES(251867,521,'-3::white background ::, 0.6::mignon, artist:quasarcake, artist:houkisei, artist:kedama milk, 40hara ::, piromizu, [ke-ta], [modare], year 2024, rhythm game concept art, grand narrative illustration, monochromatic black and white. a lone, facing a colossal, crumbling megastructure composed of interlocking gears and celestial rings that fill the entire horizon. high-tension composition with dramatic low-angle perspective to emphasize the overwhelming scale. shattered glass shards and abstract geometric prisms swirl in a violent vortex. intense chiaroscuro lighting with blinding white highlights and deep abyssal shadows. sharp, clean linework combined with expressive ink splashes and halftone patterns. the atmosphere is epic, somber, and filled with cosmic dread. in the center, the stylized title "void" is rendered in a sharp, glitchy font. masterpiece, ultra-detailed, cinematic framing, high contrast, dynamic motion blur, ethereal aesthetic, 8k resolution., very aesthetic, masterpiece, no text, -6::artist collaboration::, -3::multiple view::,','W.O.F 393','rgba(255, 123, 2, .4)',1789438928,'91fb1a05-b7c9-405b-a375-7614533308a5','ff8c0c0f-2b03-4fe1-a3bf-740f1f896476');
