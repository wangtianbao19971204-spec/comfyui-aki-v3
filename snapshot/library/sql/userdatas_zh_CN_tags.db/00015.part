INSERT INTO "tag_tags" VALUES(256750,464,'<artist>
artist:smilesmile1312,healthyman,fenrir (fenriluuu),,0.8::artist:kanzarin::,0.5::bacheally::,artist:sh_(shinh),shio (shiofeifei)
</artist>

<style>
year 2025,year 2026,fine fabric emphasis,4::cute::
