INSERT INTO "tag_tags" VALUES(257822,468,'<artist>high_complexity, ::chen_bin::, 0.8::cogecha::, na_tarapisu153, 0.8::cloneko_(zelmeledf2)::, 0.8::doribae::, 0.8::tyomimas::, 0.8::yalmyu::, 0.8::noyu_(noyu23386566)::, ::cierra_(ra-bit)::, 0.6::tianliang_duohe_fangdongye::, </artist><style> year_2025, year_2026, fine_fabric_emphasis, round_face, ultra-detailed, </style>, rossi (arknights), +_+, 1girl, solo, animal_ear_fluff, animal_ears, barefoot, cape, ears_through_headwear, ears_through_hood, fingerless_gloves, full_body, gloves, hands_on_own_knees, hood, hood_up, hooded_cape, licking_lips, looking_at_viewer, low-tied_sidelocks, red_cape, red_hood, sidelocks, solo, tail, toes, tongue, tongue_out, white_background, wolf_ears, wolf_girl, wolf_tail','DC 114','rgba(255, 123, 2, .4)',1789444883,'84ce49d9-b04f-4cef-a018-0f7d460ceb24','3cdea03f-db10-40d2-b4a3-c6d3d4621335');
INSERT INTO "tag_tags" VALUES(257823,468,'<artist>mignon, 0.8::chen_bin::, 0.8::mignon::, na_tarapisu153, 0.7::jima::, 0.8::cloneko_(zelmeledf2)::, 0.8::tyomimas::, 0.8::dino_(dinoartforame) ::, </artist> <style> year_2025, year_2026, rella, colorful, watercolour, fine_fabric_emphasis, round_face, ultra-detailed, </style>1girl, solo, oversized_white_hoodie, loose_fit, drawstrings, casual_wear, open_collar, 
blue_denim_shorts, frayed_edges, short_shorts, 
black_thighhighs, white_sneakers, casual_shoes, silver_necklace, fine_fabric_emphasis, 
.Anime-style_young_girl_with_messy, layered_hair_flowing_naturally_in_motion._She_has_large, bright_eyes_filled_with_confidence_and_the_joy_of_sports, with_a_slight_smile._Her_sleeves_billow_in_the_wind, revealing_energetic_body_lines._The_girl_is_captured_in_a_high-difficulty_moment_of_a_skateboard_jump, her_body_in_a_highly_tense_and_dynamic_mid-air_pose._Her_right_leg_is_tucked_deeply_toward_her_chest, her_left_leg_extends_downward_to_press_on_the_center_of_the_skateboard, her_right_hand_is_raised_forward_to_the_side_for_balance_with_fingers_naturally_spread, and_her_left_hand_swings_backward_and_downward_with_inertia._The_skateboard_beneath_her_features_a_light_blue_deck_with_black_trucks_and_wheels._The_background_is_a_clean, bright_outdoor_sports_field, with_sunlight_shining_from_diagonally_above, casting_soft, grainy_shadows_on_the_ground._The_overall_art_style_uses_clean_cel-shading_with_smooth, sharp_lines_and_bright, fresh_colors._The_light_and_shadow_treatment_is_delicate, with_distinct_terminators_on_the_girl''s_skin_and_clothing_folds, conveying_a_strong_sense_of_space_and_three-dimensionality._The_composition_uses_a_low-angle_shot_to_enhance_the_height_of_the_jump_and_visual_impact, featuring_extreme_clarity, rich_textures, and_a_high-quality_anime_illustration_aesthetic.','DC 115','rgba(255, 123, 2, .4)',1789444884,'b6eba355-f971-44bd-8b1b-717d4a1eb2f7','3cdea03f-db10-40d2-b4a3-c6d3d4621335');
