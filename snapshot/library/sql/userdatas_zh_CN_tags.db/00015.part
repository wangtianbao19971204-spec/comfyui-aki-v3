INSERT INTO "tag_tags" VALUES(255338,462,'at the Pingxi Sky Lantern Festival in Taiwan at night, 1.2::medium shot, from a low angle::, looking up with a bright, hopeful smile after releasing a sky lantern, wearing a casual jacket, 1.5::the sky is filled with hundreds of glowing orange sky lanterns rising like a river of stars, creating a breathtaking and magical atmosphere::, 1.2::the railway tracks are crowded with people, and the old street shops are lit up in the background, festive, spiritual, and heartwarming::','平溪天灯节放灯后仰望','rgba(255, 123, 2, .4)',1789442399,'cf00a845-15a9-4c19-b083-f6e049188eab','afdf62e6-ba22-44d5-ae72-8fcb2cf5415c');
