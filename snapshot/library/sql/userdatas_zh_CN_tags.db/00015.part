INSERT INTO "tag_tags" VALUES(257883,468,'<artist>high_complexity, mignon, 1.5::sui_yamami::, 1.25::doribae::, 1.2::cloneko_(zelmeledf2)::, 0.8::na_tarapisu153_::, 0.75::fkey::, 1.1::artist:chen_bin::, 1.1::artist:ming_zhentan_allk::, 0.8::noyu_(noyu23386566)::, 0.4::wlop::, </artist><style> year_2025, year_2026, fine_fabric_emphasis, detailed_background, round_face, ultra-detailed, detailed_background, ultra_complexity, depth_of_field, cinematic_lighting, film_grain, </style>, 1girl, loli, child, fox_girl, fox_ears, fox_tail, purple_hair, long_hair, single_sidelock, blunt_bangs, very_long_hair, black_hair_bow_on_sidelock, red_eyes, ahoge, small_breasts, solo, looking_at_viewer, closed_mouth, jewelry, upper_body, flower, earrings, one_eye_closed, japanese_clothes, hand_up, kimono, nail_polish, makeup, white_flower, bug, tassel, lipstick, butterfly, red_nails, red_lips, tassel_earrings, spider_lily, butterfly_print, butterfly_on_hand, three-quarter_view, center-left,

A_petite_fox_girl_with_very_long_straight_purple_hair, blunt_bangs, a_single_sidelock_tied_with_a_black_hair_bow, and_a_small_ahoge_at_the_crown._Her_red_eyes_catch_the_light, one_closed_as_a_dark_butterfly_perches_across_her_left_eye._She_has_fox_ears_nestled_within_her_hair._She_wears_a_gold-and-red_patterned_kimono_with_butterfly_print_and_floral_motifs_in_matte_fabric, its_collar_edged_in_red._Red_tassel_earrings_hang_from_both_ears, and_her_nails_are_painted_red._Red_lipstick_and_subtle_eye_makeup_complete_her_appearance.

The_scene_is_set_against_a_deep_crimson_background_decorated_with_swirling_cream_arabesque_patterns_that_span_the_full_width_behind_her, denser_along_the_upper_portion_and_right_side, suggesting_an_ornate_interior_or_decorative_screen._No_distinct_foreground_object_occupies_the_nearest_plane_cleanly, though_blurred_decorative_elements_in_cream_and_dark_tones_push_into_the_lower-left_and_lower-right_corners_out_of_focus, stacking_depth_against_the_sharp_midground_plane_where_she_sits.

Upper_body_shot_at_slight_eye_level, her_body_in_three-quarter_view, positioned_center-left_in_the_frame._Her_right_hand_is_raised_to_chest_height, fingers_gently_curved_upward_with_red-nailed_fingertips_visible, a_dark_butterfly_with_orange-spotted_wings_perched_across_her_left_eye_and_the_back_of_her_raised_hand._Her_left_hand_is_not_visible_within_the_framing._Her_lips_are_parted_slightly_with_red_lipstick, one_eye_closed_beneath_the_butterfly, the_open_right_eye_directed_at_viewer._Soft_diffused_lighting_enters_from_the_right, illuminating_the_right_side_of_her_face_while_the_left_falls_into_cool_shadow, with_no_strong_rim_light, rendered_in_detailed_anime_illustration_style_with_painterly_shading.','DC 175','rgba(255, 123, 2, .4)',1789444944,'cfd2526c-2326-494a-9e8d-d090f81389cc','3cdea03f-db10-40d2-b4a3-c6d3d4621335');
