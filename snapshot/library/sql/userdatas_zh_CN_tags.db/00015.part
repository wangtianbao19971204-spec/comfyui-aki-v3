INSERT INTO "tag_tags" VALUES(263998,79,'gritty anime illustration,masterwork. girl a cold,disdainful expression,leaning against a weathered concrete wall. she wears a tactical bulletproof vest over her shirt,sleeves pushed up to her elbows,and fingerless gloves. her eyes glow intensely in the dark. a smear of fresh blood stains her cheek,her mouth firmly closed in a silent threat.shaded face.from below,upper body close-up,captured from a low angle (from below) with a dramatic dutch angle to heighten the sense of unease. she points a handgun directly at the camera lens,the barrel looming large. the lighting is oppressive and cinematic,featuring high-contrast chiaroscuro with harsh shadows and sharp highlights,casting most of the scene into darkness while emphasizing the glowing eyes and the metallic sheen of the weapon. gritty atmosphere,blood splatters,ultra-detailed,4k resolution.','预备枪决','rgba(255, 123, 2, .4)',1789451059,'bd4e112d-26e7-476d-8d91-158832e6fada','6e0f3f7d-ff70-4a55-9bd4-5d45e31b0a98');
