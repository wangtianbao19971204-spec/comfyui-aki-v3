INSERT INTO "tag_tags" VALUES(264028,79,'1girl,solo,1.6::kneeling beside a rain puddle on a city rooftop,pale white "memory-steam" tendrils coalescing from the water''s surface instead of evaporating::,1.5::a cautious,reaching gesture,her fingers passing through a tendril as fragmented visions of strangers'' memories flicker around her hand,expression caught between empathy and intrusion::,1.5::a simple dark raincoat contrasted against the warm-tinted spectral tendrils,lit by the cool neon reflections in the water and the deep blue of the clear post-rain night sky::,1.4::visuals blend thermal imaging for warmth and holographic projection for memory fragments,creating transient clarity within the mist::,1.3::textures of wet asphalt,condensing vapor,shimmering heat-haze distortions,and pixelated memory glimpses::,1.2::background of rooftop vents and distant city lights,all veiled by the rising haze of collective urban memory::,masterpiece,emotional archaeology,a portrait of solitude touching the ghostly residue of others'' lives left in the rain.','丝线汲取','rgba(255, 123, 2, .4)',1789451089,'14833a9b-8bd7-4ffd-89bf-a817c562b9cd','6e0f3f7d-ff70-4a55-9bd4-5d45e31b0a98');
INSERT INTO "tag_tags" VALUES(264029,79,'1girl,solo,1.6::leaning against a rusted television antenna under a full moon,tendrils of dead radio waves seeping from corroded joints,composed of historical broadcast remnants and static::,1.5::a strained,listening pose,hands gripping her modified headset as spectral tendrils plug into its ports,forcing her to hear echoes of the past,expression tense with overload::,1.5::urban explorer attire contrasted against the rust-and-static texture of the wave-tendrils,lit by the cold moonlight and the ghostly glow of vintage test patterns overlaying the moon''s surface::,1.4::multiple radio spectrogram layers visualize different eras as colored frequency lines,with her form a bright digital signal point amidst the analog noise::,1.3::textures of oxidized metal,crystallized static,worn headphones,and shifting signal graphs::,1.2::background of a vast night sky,its darkness textured with faint,overlapping transmission waves from decades past::,spectral haunting,the weight of broadcast history forcibly channeled through a single listener under the test-pattern moon.','破败电台','rgba(255, 123, 2, .4)',1789451090,'ec591ba9-d65f-4179-a115-1d7a032d3873','6e0f3f7d-ff70-4a55-9bd4-5d45e31b0a98');
