INSERT INTO "tag_tags" VALUES(256751,464,'<artist>
artist:smilesmile1312,healthyman,fenrir (fenriluuu),0.8::artist:sh_(shinh),shio (shiofeifei)::,0.6::kanzarin::,0.6::bacheally::,takashima shoa
</artist>

<style>
year 2025,year 2026,fine fabric emphasis,cute,-1::no lineary::
</style>

```xml
<artwork>
  <rendering_and_art_style>
    Clean digital anime illustration featuring sharp, dark purple-tinted dynamic line art with variable weighting. Vibrant cel-shading combined with crisp planar shadow casting, soft airbrushed specular bloom, and comic-style hatch marks along garment edges.
  </rendering_and_art_style>

  <color_system>
    <dominant_palette>
      <color name="Hooded Cape Primary" hex="#E35875" />
      <color name="Cape Shadow Tone" hex="#983353" />
      <color name="Gear &amp; Straps Slate Purple" hex="#6B5D7A" />
      <color name="Hair Pale Blonde" hex="#FFF1B5" />
      <color name="Iris Amber Gold" hex="#FF9E1B" />
      <color name="Blade Steel Specular" hex="#EAE8F2" />
      <color name="Neutral Studio Background" hex="#CBC8CC" />
    </dominant_palette>
    <chromatic_dynamic>
      High-contrast palette balancing warm coral-crimson outerwear against cool slate-purple utility harnesses and a neutral studio grey background, accented by luminous yellow-orange eyes and polished metallic blade reflections.
    </chromatic_dynamic>
  </color_system>

  <camera_and_composition bbox="[0, 0, 1000, 1000]">
    Close-up dynamic Dutch-angle portrait. The diagonal positioning of the broad tactical blade spans across the midground, slicing the frame from top-left to bottom-right. Focal emphasis is locked onto the intense gaze peering directly over the weapon''s spine.
  </camera_and_composition>

  <lighting_and_atmosphere>
    Strong front-overhead directional key light producing sharp, geometric shadow cutoffs cast by the jagged hood and the large blade. High-intensity specular sheen sweeps across the top edge of the blade, accompanied by soft warm subsurface bloom on the pale skin.
  </lighting_and_atmosphere>

  <character_and_anatomy bbox="[0, 0, 1000, 1000]">
    <identity>
      Rossi from Arknights: Endfield. Lupo/wolf girl traits featuring large pointed canine ears protruding through custom hood apertures, dense white inner ear fluff, and a bushy blonde-tan tail visible at the lower right.
    </identity>
    
    <facial_structure_and_expression bbox="[180, 380, 460, 780]">
      Compact anime jawline partially occluded by the weapon. Intense, focused forward gaze. Large stylized eyes with bright golden-amber irises (`#FF9E1B`), red-orange gradient depths (`#D65E12`), sharp dark eyelashes, and precise horizontal pupils.
    </facial_structure_and_expression>

    <hair_architecture>
      Pale buttery blonde hair (`#FFF1B5`) with soft golden shading (`#E5B869`). Choppy straight-cut front bangs framing the eyes, with layered side locks and a small bundled ponytail tied at the front beneath the blade.
    </hair_architecture>

    <pose_and_biomechanics>
      Dynamic defensive guard stance. Shoulders angled with both arms raised to present a heavy combat blade horizontally at mouth level, hands gripping the mechanical hilt and tactical fixtures.
    </pose_and_biomechanics>

    <attire_and_materials>
      Voluminous coral-red hooded mantle (`#E35875`) with stylized jagged saw-tooth front edges and strap buckles. Underneath rests a pale dress shirt fitted with heavy industrial tactical webbing, purple-grey buckled harnesses (`#6B5D7A`), thigh straps, and segmented mechanical modules.
    </attire_and_materials>
  </character_and_anatomy>

  <environment_and_scenery>
    Solid minimalist flat grey background (`#CBC8CC`) providing clean graphic contrast, keeping full visual priority on the character''s intricate silhouette, weapon mechanics, and saturated palette.
  </environment_and_scenery>
</artwork>
